# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=media_asset_dashboard

# --- Auth -------------------------------------------------------------------
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- HTTP -------------------------------------------------------------------
PORT=3001
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- S3 (asset file storage) ------------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET_NAME=media-assets-local

# Local development with the S3Mock container from docker-compose.yml.
# For real AWS: delete these four lines and use `aws configure` or an IAM
# role. Never put real AWS access keys in this file.
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=local-dev
AWS_SECRET_ACCESS_KEY=local-dev
