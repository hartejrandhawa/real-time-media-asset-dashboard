DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=media_asset_dashboard
JWT_SECRET=replace-with-a-long-random-string
PORT=3001

# AWS S3 (asset file storage)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-media-assets-bucket
# AWS credentials: use `aws configure` locally, or an IAM role when
# deployed to Lambda — do not hardcode access keys here.
